{
    "name": "fabioaugustorodrigues/kmzinho",
    "type": "project",
    "description": "Open-source REST API that computes real driving-route distances between Brazilian addresses, built on the iMono framework",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "php-di/php-di": "^6.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    }
}
