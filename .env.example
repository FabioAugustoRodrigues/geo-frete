# production | development | testing
APP_ENV=development

# Values below target PHP running on the host (XAMPP, php -S, PHPUnit) and the
# MySQL container published on port 3307. Inside Docker Compose, the api
# service overrides DB_HOST/DB_PORT to reach the mysql service directly.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=geo_frete
DB_PASS=geo_frete
DB_NAME=geo_frete

CACHE_TYPE=array

# Comma-separated API keys accepted in "Authorization: Bearer <key>".
# Empty disables authentication (development only).
API_KEYS=

# Requests per minute per API key (or per IP when authentication is off).
RATE_LIMIT_PER_MINUTE=120

# OpenStreetMap services (Nominatim) require identifying the app with a real,
# monitored contact; requests with a fake contact (e.g. example.com) get blocked.
APP_USER_AGENT=geo-frete/0.1
APP_CONTACT=

NOMINATIM_URL=https://nominatim.openstreetmap.org

# Timeout, in seconds, for calls to external providers.
HTTP_TIMEOUT=8

# Days a geocoded address stays cached.
GEOCODING_CACHE_DAYS=180

# Straight-line distance multiplier used to estimate the road distance.
ROUTE_FACTOR=1.3
