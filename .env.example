# production | development | testing
APP_ENV=development

# Values below target PHP running on the host (XAMPP, php -S, PHPUnit) and the
# MySQL container published on port 3307. Inside Docker Compose, the api
# service overrides DB_HOST/DB_PORT to reach the mysql service directly.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=geo_frete
DB_PASS=geo_frete
DB_NAME=geo_frete

CACHE_TYPE=array

# Comma-separated API keys accepted in "Authorization: Bearer <key>".
# Empty disables authentication (development only).
API_KEYS=

# Requests per minute per API key per client IP (or per IP when authentication is off).
RATE_LIMIT_PER_MINUTE=120

# Sites allowed to call the API from a browser: "*" for any, or a comma-separated
# list such as https://your-site.com,http://localhost:5173 (no trailing slash).
CORS_ALLOWED_ORIGINS=*

# OpenStreetMap services (Nominatim) require a User-Agent identifying the app.
# APP_CONTACT is optional but recommended (they can reach you before blocking);
# never use a fake one (e.g. example.com): fake contacts get blocked.
APP_USER_AGENT=kmzinho/0.1
APP_CONTACT=

NOMINATIM_URL=https://nominatim.openstreetmap.org

# Timeout, in seconds, for calls to external providers.
HTTP_TIMEOUT=8

# IBGE sources for bin/import-cnefe.php: municipality codes and CNEFE files
# (2022 Census address list). Downloads are cached in CNEFE_DATA_DIR.
IBGE_LOCALITIES_URL=https://servicodados.ibge.gov.br/api/v1/localidades
CNEFE_BASE_URL=https://ftp.ibge.gov.br/Cadastro_Nacional_de_Enderecos_para_Fins_Estatisticos/Censo_Demografico_2022/Arquivos_CNEFE/CSV/Municipio
# Leave empty to use data/cnefe inside the project.
CNEFE_DATA_DIR=

# OSRM routing server. Inside Docker Compose the api service overrides this
# with http://osrm:5000; this value serves PHP running on the host.
OSRM_URL=http://127.0.0.1:5000

# Seconds to wait for OSRM before falling back to the straight-line estimate.
OSRM_TIMEOUT=3

# If OSRM must move a geocoded point farther than this (km) to reach a road,
# the point is probably wrong and the response asks for confirmation.
SNAP_WARNING_KM=0.3

# Name of the routing map built by the map-clip/map-build services.
OSRM_MAP_NAME=limeira

# Days a geocoded address stays cached.
GEOCODING_CACHE_DAYS=180

# Straight-line distance multiplier, used only when OSRM cannot answer.
ROUTE_FACTOR=1.3
