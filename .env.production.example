# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env
# then replace every CHANGE_ME. Never commit the resulting .env.

# Public address of the API, used by Caddy to get the HTTPS certificate.
# Either a subdomain of a domain you own, pointed (DNS "A" record) at the VPS:
#   API_HOST=api.example.com
# or, with no domain at all, sslip.io, which resolves to the IP written in the name
# (VPS IP 203.0.113.10 -> 203-0-113-10.sslip.io):
API_HOST=CHANGE_ME

# Database. The api container reaches it through the internal Docker network.
DB_NAME=kmzinho
DB_USER=kmzinho
DB_PASS=CHANGE_ME
# Only used by MySQL itself; long and random, like DB_PASS.
DB_ROOT_PASS=CHANGE_ME

# Comma-separated API keys. A key used by a public web page is visible to its
# visitors: give that page its own key, so it can be replaced without touching
# other consumers. Generate keys with: openssl rand -hex 24
API_KEYS=CHANGE_ME

# Requests per minute per API key per visitor IP.
RATE_LIMIT_PER_MINUTE=60

# Sites allowed to call the API from a browser (comma-separated, no trailing slash),
# e.g. https://your-site.com,http://localhost:5173. "*" allows any site.
CORS_ALLOWED_ORIGINS=CHANGE_ME

# OpenStreetMap services require a User-Agent identifying the app; the contact
# e-mail is optional but recommended (never a fake one).
APP_USER_AGENT=kmzinho/0.1
APP_CONTACT=

# Name of the routing map built by map-clip/map-build.
OSRM_MAP_NAME=limeira

# Every other setting has a sensible default: see .env.example for the full list.
