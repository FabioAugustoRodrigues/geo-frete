RewriteEngine On

# The document root is the project root (there is no isolated "public/"
# folder), so everything that is not the front controller must be blocked.
# Rules match by kind, not by name, so a new file is never exposed by
# forgetting to list it here.

# Hidden files and folders: .env, .git, .github, .htaccess...
RewriteRule (^|/)\. - [F,L]

# Configuration, documentation, data and scripts, whatever their name.
RewriteRule \.(ya?ml|md|json|lock|sql|sh|ini|conf|xml|dist|example|log|bak)$ - [F,L]

# Folders that are never served (app/ includes the code and the views).
RewriteRule ^(app|bin|data|database|docker|docs|osrm-data|private|storage|vendor)(/|$) - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.*)$ index.php [NC,L]
